{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true
  },
  "dockerfile": {
    "managerFilePatterns": ["/(^|/)Containerfile$/"]
  },
  "packageRules": [
    {
      "description": "Base image digest bumps are for a deliberate manual local rebuild",
      "matchManagers": ["dockerfile"],
      "labels": ["dependencies", "container"],
      "pinDigests": true
    }
  ]
}
